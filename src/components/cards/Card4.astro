---
import { cn, getZIndex } from "../../lib/utils";
import { getSiteInfos } from "../../lib/infos";

type Props = {
    class?: string;
    cardIndex?: number;
    cardCount?: number;
}

const {
    class: className,
    cardIndex = 0,
    cardCount = 1
} = Astro.props;

const zindex = getZIndex(cardIndex, cardCount);
const infos = getSiteInfos();
const currentYear = new Date().getFullYear();
---

<script>
    import { animate } from 'motion';
    import { parseNumberWithDefault } from '../../lib/utils';

    const cardIndex = parseNumberWithDefault(document.getElementById('card-4-container')?.dataset.cardIndex, 0);

    const animDuration = 0.7;
    const animDelay = 0.34;

    const makeContainerVisible = () => {
        document.getElementById('card-4-container')?.classList.remove('hidden');
    }

    const makeContainerInvisible = () => {
        document.getElementById('card-4-container')?.classList.add('hidden');
    }

    function beforeToDuring() {
        makeContainerVisible();

        const baseDelay = 2;

        animate('#card-4-title', {
            transform: ['translateY(-100%)', 'translateY(0)'],
        }, {
            duration: animDuration,
            delay: baseDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-contact-phone', {
            opacity: [0, 1],
            transform: ['translateX(-20px)', 'translateX(0)'],
        }, {
            duration: animDuration,
            delay: baseDelay + animDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-contact-email', {
            opacity: [0, 1],
            transform: ['translateX(-20px)', 'translateX(0)'],
        }, {
            duration: animDuration,
            delay: baseDelay + 2 * animDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-contact-instagram', {
            opacity: [0, 1],
            transform: ['translateX(-20px)', 'translateX(0)'],
        }, {
            duration: animDuration,
            delay: baseDelay + 3 * animDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-footer', {
            opacity: [0, 1],
        }, {
            duration: animDuration,
            delay: baseDelay + 4 * animDelay,
            ease: 'easeInOut'
        }).then(() => {
            window.unlockCardsAnimation();
        });
    }

    function duringToBefore() {
        animate('#card-4-footer', {
            opacity: [1, 0],
        }, {
            duration: animDuration,
            delay: 0,
            ease: 'easeInOut'
        });

        animate('#card-4-contact-instagram', {
            opacity: [1, 0],
            transform: ['translateX(0)', 'translateX(-20px)'],
        }, {
            duration: animDuration,
            delay: animDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-contact-email', {
            opacity: [1, 0],
            transform: ['translateX(0)', 'translateX(-20px)'],
        }, {
            duration: animDuration,
            delay: 2 * animDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-contact-phone', {
            opacity: [1, 0],
            transform: ['translateX(0)', 'translateX(-20px)'],
        }, {
            duration: animDuration,
            delay: 3 * animDelay,
            ease: 'easeInOut'
        });

        animate('#card-4-title', {
            transform: ['translateY(0)', 'translateY(-100%)'],
        }, {
            duration: animDuration,
            delay: 4 * animDelay,
            ease: 'easeInOut'
        }).then(() => {
            makeContainerInvisible();
        });
    }

    window.registerCard(cardIndex, {
        beforeToDuring,
        duringToBefore
    });
</script>

<div
    id="card-4-container"
    data-card-index={cardIndex}
    data-card-count={cardCount}
    class={cn(
        "fixed w-screen h-screen hidden",
        "bg-neutral-900",
        className
    )}
    style={`z-index: ${zindex};`}
>
    <div 
        id="card-4-content"
        class={cn(
            "relative w-full h-full",
            "px-[10%] md:px-[12%] lg:px-[16%] xl:px-[20%]",
            "flex flex-col items-center justify-center",
        )}
    >
        <div class="flex flex-col items-center gap-8 md:gap-12">
            <div class="overflow-hidden">
                <h2
                    id="card-4-title"
                    class={cn(
                        "text-2xl md:text-3xl lg:text-4xl",
                        "font-semibold uppercase",
                        "text-white",
                    )}
                >
                    Contact
                </h2>
            </div>

            <div class="flex flex-col items-center gap-4 md:gap-6 text-white">
                <a
                    id="card-4-contact-phone"
                    href={`tel:${infos.phone.replace(/\s/g, '')}`}
                    class={cn(
                        "flex items-center gap-3",
                        "text-lg md:text-xl",
                        "hover:text-accent1 transition-colors",
                        "opacity-0"
                    )}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span>{infos.phone}</span>
                </a>

                <a
                    id="card-4-contact-email"
                    href={`mailto:${infos.contactEmail}`}
                    class={cn(
                        "flex items-center gap-3",
                        "text-lg md:text-xl",
                        "hover:text-accent1 transition-colors",
                        "opacity-0"
                    )}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>{infos.contactEmail}</span>
                </a>

                <a
                    id="card-4-contact-instagram"
                    href={`https://instagram.com/${infos.instagram.replace('@', '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={cn(
                        "flex items-center gap-3",
                        "text-lg md:text-xl",
                        "hover:text-accent1 transition-colors",
                        "opacity-0"
                    )}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    <span>{infos.instagram}</span>
                </a>
            </div>
        </div>

        <footer
            id="card-4-footer"
            class={cn(
                "absolute bottom-6 md:bottom-8",
                "flex flex-col items-center gap-2",
                "text-sm text-neutral-400",
                "opacity-0"
            )}
        >
            <p>© {currentYear} Pierre Lemmel</p>
            <a
                href="/mentions-legales"
                class="hover:text-white transition-colors underline underline-offset-2"
            >
                Mentions légales
            </a>
        </footer>
    </div>
</div>

