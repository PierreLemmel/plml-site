---
import { cn, getZIndex } from '../../lib/utils';
import WiggleArrow from '../WiggleArrow.astro';

type Props = {
    class?: string;
    cardIndex?: number;
    cardCount?: number;
}

const {
    class: className,
    cardIndex = 0,
    cardCount = 1
} = Astro.props;

const letterThickness = 2;
const lettersSpacing = 3;

const zindex = getZIndex(cardIndex, cardCount);

---

<script>
    import { animate } from 'motion';
    import { parseNumberWithDefault } from '../../lib/utils';

    const animDuration = 0.7;
    const animDelay = 0.45;

    const cardContainer = document.getElementById('card-1-container')!;
    const scrollArrow = document.getElementById('card-1-scroll-arrow')!;

    const cardIndex = parseNumberWithDefault(cardContainer.dataset.cardIndex, 0);

    function animateIn(initialDelay: number) {
        cardContainer.classList.remove('hidden');

        const baseDelay = initialDelay;

        animate('#svg-letter-p', {
            strokeDashoffset: 0,
        }, {
            duration: animDuration,
            delay: baseDelay,
            ease: 'easeInOut'
        });

        animate('#svg-letter-l1', {
            strokeDashoffset: 0,
        }, {
            duration: animDuration,
            delay: baseDelay + animDelay,
            ease: 'easeInOut'
        });

        animate('#svg-letter-m', {
            strokeDashoffset: 0,
        }, {
            duration: 1.4 * animDuration,
            delay: baseDelay + 2 * animDelay,
            ease: 'easeInOut'
        });

        animate('#svg-letter-l2', {
            strokeDashoffset: 0,
        }, {
            duration: animDuration,
            delay: baseDelay + 3 * animDelay,
            ease: 'easeInOut'
        });

        animate('#card-1-container', {
            '--card-1-gradient-color-1': '#000000'
        }, {
            duration: 2.5 * animDuration,
            delay: baseDelay + 0.8 * animDelay,
            ease: 'easeIn'
        });

        animate('#card-1-container', {
            '--card-1-gradient-color-2': '#000000'
        }, {
            duration: 2.5 * animDuration,
            delay: baseDelay + 0 * animDelay,
            ease: 'easeIn'
        });


        animate('#card-1-scroll-arrow', {
            opacity: [0, 1],
        }, {
            duration: 0.7 * animDuration,
            delay: baseDelay + 5.5 * animDelay,
            ease: 'linear'
        }).then(() => {
            scrollArrow.classList.remove('pointer-events-none');
        });

        animate('#card-1-tagline', {
            transform: ['translateY(-100%)', 'translateY(0)'],
        }, {
            duration: 1.5 * animDuration,
            delay: baseDelay + 3.5 * animDelay,
            ease: 'easeIn'
        }).then(() => {
            window.unlockCardsAnimation();
        });
    }

    function animateOut() {
        scrollArrow.classList.add('pointer-events-none');

        animate('#svg-letter-p', {
            strokeDashoffset: 100,
        }, {
            duration: animDuration,
            delay: 4 * animDelay,
            ease: 'easeInOut'
        }).then(() => {
            cardContainer.classList.add('hidden');
        });

        animate('#svg-letter-l1', {
            strokeDashoffset: 100,
        }, {
            duration: animDuration,
            delay: 3 * animDelay,
            ease: 'easeInOut'
        });

        animate('#svg-letter-m', {
            strokeDashoffset: 100,
        }, {
            duration: 1.4 * animDuration,
            delay: 2 * animDelay,
            ease: 'easeInOut'
        });

        animate('#svg-letter-l2', {
            strokeDashoffset: -100,
        }, {
            duration: animDuration,
            ease: 'easeInOut'
        })

        animate('#card-1-container', {
            '--card-1-gradient-color-1': 'rgba(0, 0, 0, 0)'
        }, {
            duration: 2.5 * animDuration,
            delay: 0.8 * animDelay,
            ease: 'easeIn'
        });

        animate('#card-1-container', {
            '--card-1-gradient-color-2': 'rgba(0, 0, 0, 0)'
        }, {
            duration: 2.5 * animDuration,
            delay: 2.2 * animDelay,
            ease: 'easeIn'
        });

        animate('#card-1-tagline', {
            transform: 'translateY(-100%)',
        }, {
            duration: 1.5 * animDuration,
            delay: 0,
            ease: 'easeIn'
        });

        animate('#card-1-scroll-arrow', {
            opacity: [1, 0],
        }, {
            duration: 0.7 * animDuration,
            delay: 0,
            ease: 'linear'
        });
    }

    function hide() {
        cardContainer.classList.add('hidden');
    }

    function show() {
        cardContainer.classList.remove('hidden');
    }

    window.registerCard(
        cardIndex,
        [
            "menu"
        ],
        {
            beforeToDuring: () => animateIn(0),
            duringToBefore: () => animateOut(),
            duringToAfter: () => animateOut(),
            afterToDuring: () => animateIn(1.55),
            hide,
            show
        }
    );

    function syncTaglineScale() {
        const svgWidth = document.getElementById("card-1-svg")?.clientWidth;
        const tagline = document.getElementById("card-1-tagline-container");
        if (svgWidth && tagline) {
            tagline.style.transform = 'scale(1)';
            const textWidth = tagline.clientWidth;
            const scale = (svgWidth + 30) / textWidth;
            tagline.style.transform = `scale(${scale})`;
        }
    }

    syncTaglineScale();

    const resizeObserver = new ResizeObserver(() => {
        syncTaglineScale();
    });

    const container = document.getElementById("card-1-container");
    if (container) {
        resizeObserver.observe(container);
    }
</script>

<div
    class={cn(
        "fixed w-screen h-screen",
        "flex flex-col items-center justify-center gap-10",
        "px-[10%] md:px-[12%] lg:px-[16%] xl:px-[20%]",
        "card-1-gradient",
        className
    )}
    style={`z-index: ${zindex};`}
    id="card-1-container"
    data-card-index={cardIndex}
    data-card-count={cardCount}
>
    <svg
        class={cn(
            "overflow-visible"
        )}
        id="card-1-svg"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="10 10 230 80"
        fill="none"
        stroke="currentColor"
        stroke-width={letterThickness}
        stroke-linecap="round"
        stroke-linejoin="round"
        style={{
            paddingLeft: `${lettersSpacing}px`,
            paddingRight: `${lettersSpacing}px`,
        }}
    >
        <!-- P -->
        <path
            id="svg-letter-p"
            style={{
                transform:`translateX(${-2 * lettersSpacing}px)`
            }}
            d="M10 90 L10 10 L35 10 C55 10 55 45 35 45 L10 45"
            pathLength="99"
            stroke-dasharray="100"
            stroke-dashoffset="100"
        />
        
        <!-- L -->
        <path
            id="svg-letter-l1"
            style={{
                transform:`translateX(${-lettersSpacing}px)`
            }}
            d="M70 10 L70 90 L110 90"
            pathLength="99"
            stroke-dasharray="100"
            stroke-dashoffset="100"
        />
        
        <!-- M -->
        <path
            id="svg-letter-m"
            style={{
                transform:`translateX(${lettersSpacing}px)`
            }}
            d="M125 90 L125 10 L155 50 L185 10 L185 90"
            pathLength="99"
            stroke-dasharray="100"
            stroke-dashoffset="100"
        />
        
        <!-- L -->
        <path
            id="svg-letter-l2"
            style={{
                transform:`translateX(${2 * lettersSpacing}px)`
            }}
            d="M200 10 L200 90 L240 90"
            pathLength="99"
            stroke-dasharray="100"
            stroke-dashoffset="-100"
        />
    </svg>
    <div 
        id="card-1-tagline-container"
        class={cn(
            "flex flex-col items-center",
            "overflow-hidden"
        )}
    >
        <div
            id="card-1-tagline"
            class={cn(
                "text-center",
                "text-white/70",
                "font-barlow",
                "font-thin",
                "uppercase",
                "italic"
            )}
            style={{
                transform: 'translateY(-100%)',
            }}
        >
            Arts numériques, théâtre et autres trucs...
        </div>
    </div>
    <WiggleArrow
        id="card-1-scroll-arrow"
        visible={false}
        class="absolute bottom-20 md:bottom-8 lg:bottom-6"
    />
    
</div>

<style>
    .card-1-gradient {
        --card-1-gradient-color-1: rgba(0, 0, 0, 1);
        --card-1-gradient-color-2: rgba(0, 0, 0, 1);
        background: linear-gradient(to top right, var(--card-1-gradient-color-1), var(--card-1-gradient-color-2));
    }
</style>