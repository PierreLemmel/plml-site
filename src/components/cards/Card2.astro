---
import { cn, getZIndex } from "../../lib/utils";
import ShaderBackground from "../ShaderBackground.astro";
import WiggleArrow from "../WiggleArrow.astro";
import fragmentShader from "../../shaders/presentation.frag?raw";

type Props = {
    class?: string;
    cardIndex?: number;
    cardCount?: number;
}

const {
    class: className,
    cardIndex = 0,
    cardCount = 1
} = Astro.props;

const zindex = getZIndex(cardIndex, cardCount);

const hasLinkToAbout = false;

---

<script>
    import { animate } from 'motion';
    import { clamp, parseNumberWithDefault } from '../../lib/utils';

    const cardContainer = document.getElementById('card-2-container')!;
    const scrollArrow = document.getElementById('card-2-scroll-arrow')!;

    const cardIndex = parseNumberWithDefault(cardContainer.dataset.cardIndex, 0);
    const hasLinkToAbout = cardContainer.dataset.hasLinkToAbout === 'true';

    const canvas = document.getElementById('card2-background') as HTMLCanvasElement;
    const canvasContainer = document.getElementById('card2-background-container')!;

    const textAnimDuration = 0.7;
    const textAnimDelay = 0.34;
    const backgroundAnimDuration = 1.6;

    const paragraphCount = hasLinkToAbout ? 4 : 3;

    const makeContainerVisible = () => {
        cardContainer.classList.remove('hidden');
    }

    const makeContainerInvisible = () => {
        cardContainer.classList.add('hidden');
    }

    function beforeToDuring() {
        makeContainerVisible();

        const baseDelay = 2.5;
        
        const intensityTarget = { intensity: 1 };
        const scaleTarget = { scale: 1.15 };

        canvasContainer.style.opacity = '1';
        
        canvas.shaderUniforms!.fIntensity.value = 1;
        canvas.shaderUniforms!.fOpacity.value = 1;
        canvas.shaderUniforms!.fThreshold.value = -0.1;
        canvas.style.opacity = '1';

        animate(
            intensityTarget,
            { intensity: 0.45 },
            { 
                duration: backgroundAnimDuration,
                delay: baseDelay,
                ease: 'easeInOut',
                onUpdate: () => {
                    if (canvas.shaderUniforms) {
                        canvas.shaderUniforms.fIntensity.value = intensityTarget.intensity;
                    }
                }
            }
        );

        animate(
            scaleTarget,
            { scale: 1 },
            { 
                duration: backgroundAnimDuration * 2.5,
                delay: 0,
                ease: 'easeOut',
                onUpdate: () => {
                    if (canvas.shaderUniforms) {
                        canvas.shaderUniforms.fScale.value = scaleTarget.scale;
                    }
                }
            }
        );

        animate("#card-2-title", {
            transform: ['translateY(-100%)', 'translateY(0)'],
        }, {
            duration: textAnimDuration,
            delay: baseDelay,
            ease: 'easeInOut'
        });

        for (let i = 1; i <= paragraphCount; i++) {
            animate(`#card-2-text-${i}`, {
                transform: ['translateY(-100%)', 'translateY(0)'],
            }, {
                duration: textAnimDuration,
                delay: baseDelay + i * textAnimDelay,
                ease: 'easeInOut'
            });
        }

        animate("#card-2-portrait", {
            opacity: [0.4, 1],
            transform: ['scale(0)', 'scale(1)'],
        }, {
            duration: textAnimDuration,
            delay: baseDelay + 3 * textAnimDelay,
            ease: 'linear'
        });

        scrollArrow.classList.add('pointer-events-none');
        animate("#card-2-scroll-arrow", {
            opacity: [0, 1],
        }, {
            duration: 0.7 * textAnimDuration,
            delay: baseDelay + 4 * textAnimDelay,
            ease: 'linear'
        }).then(() => {
            scrollArrow.classList.remove('pointer-events-none');
            window.unlockCardsAnimation();
        });
    }

    function duringToBefore() {
        scrollArrow.classList.add('pointer-events-none');
        animate("#card-2-scroll-arrow", {
            opacity: [1, 0],
        }, {
            duration: 0.5 * textAnimDuration,
            delay: 0,
            ease: 'linear'
        });

        for (let i = 1; i <= paragraphCount; i++) {
            animate(`#card-2-text-${i}`, {
                transform: ['translateY(0)', 'translateY(-100%)'],
            }, {
                duration: textAnimDuration,
                delay: (4 - i) * textAnimDelay,
                ease: 'easeInOut'
            });
        }

        animate("#card-2-title", {
            transform: ['translateX(0)', 'translateX(-100%)'],
        }, {
            duration: textAnimDuration,
            delay: 3 * textAnimDelay,
            ease: 'easeInOut'
        }).then(() => {
            setTimeout(() => {
                makeContainerInvisible();
            }, 2000);
        });

        
        animate("#card-2-portrait", {
            opacity: [1, 0.4],
            transform: ['scale(1)', 'scale(0)'],
        }, {
            duration: textAnimDuration,
            delay: 2 * textAnimDelay,
            ease: 'linear'
        })

        const intensityTarget = { intensity: 0.45 };
        const scaleTarget = { scale: 1 };
        animate(
            intensityTarget,
            { intensity: 1 },
            { 
                duration: backgroundAnimDuration,
                delay: 1 * textAnimDelay,
                ease: 'easeInOut',
                onUpdate: () => {
                    if (canvas.shaderUniforms) {
                        canvas.shaderUniforms.fIntensity.value = intensityTarget.intensity;
                    }
                }
            }
        );

        animate(
            scaleTarget,
            { scale: 1.15 },
            { 
                duration: backgroundAnimDuration * 2.5,
                delay: 0,
                ease: 'easeOut',
                onUpdate: () => {
                    if (canvas.shaderUniforms) {
                        canvas.shaderUniforms.fScale.value = scaleTarget.scale;
                    }
                }
            }
        );
    }
    
    function duringToAfter() {
        scrollArrow.classList.add('pointer-events-none');
        animate("#card-2-scroll-arrow", {
            opacity: [1, 0],
        }, {
            duration: 0.5 * textAnimDuration,
            delay: 0,
            ease: 'linear'
        });

        for (let i = 1; i <= paragraphCount; i++) {
            animate(`#card-2-text-${i}`, {
                transform: ['translateY(0)', 'translateY(-100%)'],
            }, {
                duration: textAnimDuration,
                delay: (paragraphCount - i) * textAnimDelay,
                ease: 'easeInOut'
            });
        }

        animate("#card-2-title", {
            transform: ['translateX(0)', 'translateX(-100%)'],
        }, {
            duration: textAnimDuration,
            delay: 3 * textAnimDelay,
            ease: 'easeInOut'
        });

        
        animate("#card-2-portrait", {
            opacity: [1, 0.4],
            transform: ['scale(1)', 'scale(0)'],
        }, {
            duration: textAnimDuration,
            delay: 2 * textAnimDelay,
            ease: 'linear'
        })

        const thresholdTarget = { threshold: -0.1 };

        canvasContainer.style.opacity = "100%";
        canvas.shaderUniforms!.fThreshold.value = 1;
        animate(
            thresholdTarget,
            { threshold: 1 },
            { 
                duration: 1.5 * backgroundAnimDuration,
                delay: 2 * textAnimDelay,
                ease: 'easeIn',
                onUpdate: () => {
                    if (canvas.shaderUniforms) {
                        canvas.shaderUniforms.fThreshold.value = thresholdTarget.threshold;
                    }
                }
            }
        ).then(() => {
            makeContainerInvisible();
        });
    }

    function afterToDuring() {
        const baseDelay = 2;

        makeContainerVisible();

        for (let i = 1; i <= paragraphCount; i++) {
            animate(`#card-2-text-${i}`, {
                transform: ['translateY(-100%)', 'translateY(0)'],
            }, {
                duration: textAnimDuration,
                delay: baseDelay + i * textAnimDelay,
                ease: 'easeInOut'
            });
        }

        animate("#card-2-title", {
            transform: ['translateY(-100%)', 'translateY(0)'],
        }, {
            duration: textAnimDuration,
            delay: baseDelay,
            ease: 'easeInOut'
        });

        
        animate("#card-2-portrait", {
            opacity: [0.4, 1],
            transform: ['scale(0)', 'scale(1)'],
        }, {
            duration: textAnimDuration,
            delay: baseDelay + 4 * textAnimDelay,
            ease: 'linear'
        });

        scrollArrow.classList.add('pointer-events-none');
        animate("#card-2-scroll-arrow", {
            opacity: [0, 1],
        }, {
            duration: 0.7 * textAnimDuration,
            delay: baseDelay + 4 * textAnimDelay,
            ease: 'linear'
        }).then(() => {
            scrollArrow.classList.remove('pointer-events-none');
            window.unlockCardsAnimation();
        });

        const thresholdTarget = { threshold: 1 };
        animate(
            thresholdTarget,
            { threshold: -0.1 },
            { 
                duration: 1.5 * backgroundAnimDuration,
                delay: 0,
                ease: 'easeIn',
                onUpdate: () => {
                    if (canvas.shaderUniforms) {
                        canvas.shaderUniforms.fThreshold.value = thresholdTarget.threshold;
                    }
                }
            }
        );
    }

    function hide() {
        cardContainer.classList.add('hidden');
    }

    function show() {
        cardContainer.classList.remove('hidden');
    }

    window.registerCard(
        cardIndex,
        [
            "a-propos",
            "about"
        ],
        {
            beforeToDuring,
            duringToBefore,
            duringToAfter,
            afterToDuring,
            hide,
            show
        }
    );
</script>

<div
    id="card-2-container"
    data-has-link-to-about={hasLinkToAbout}
    data-card-index={cardIndex}
    data-card-count={cardCount}
    class={cn(
        "fixed w-screen h-screen",
        className
    )}
    style={`z-index: ${zindex};`}
>
    <div class={cn(
        "relative w-full h-full",
        "px-[10%] md:px-[12%] lg:px-[16%] xl:px-[20%]",
        "flex flex-col items-center justify-center",
        "overflow-hidden"
    )}>
        <ShaderBackground 
            id="card2-background" 
            class="absolute inset-0"
            fragmentShader={fragmentShader}
            uniforms={{
                fScale: 1.0,
                fIntensity: 1.0,
                fOpacity: 1.0,
                fSpeed: 1.0,
                fThreshold: 0.2
            }}
            pixelRatio={0.25}
        />

        <div class={cn(
            "grid",
            "grid-cols-1 md:grid-cols-[2fr_3fr]",
            "sm:grid-rows-[auto_auto_1fr] md:grid-rows-[auto_1fr]",
            "gap-5 lg:gap-6 xl:gap-x-10",
            "z-10",
            "max-h-[90vh]"
        )}>
            <div class={cn(
                "overflow-hidden",
                "md:col-span-2"
            )}>
                <div
                    id="card-2-title"
                    class={cn(
                        "text-2xl md:text-3xl lg:text-4xl font-bold",
                        "font-semibold uppercase",
                        "text-white",
                    )}
                >
                    Qui suis-je ?
                </div>
            </div>

            <div
                id="card-2-portrait"
                class={cn(
                    "bg-center bg-cover bg-no-repeat",
                    "bg-[url('/img/portrait-pierre-02.jpg')]",
                    "rounded-md",
                    "h-[max(12rem,10vh)] sm:h-48 md:h-auto"
                )}
            />
            <div class={cn(
                "flex flex-col items-stretch justify-start md:justify-center",
                "max-h-full",
                "md:text-lg",
                "gap-2 sm:gap-3 md:gap-4",
                "overflow-y-auto",
                "min-h-0"
            )}>
                <div class="overflow-hidden">
                    <div id="card-2-text-1">
                        Je m&apos;appelle Pierre Lemmel, je suis artiste numérique, comédien, metteur-en-scène et technicien lumière.
                    </div>
                </div>
                <div class="overflow-hidden">
                    <div id="card-2-text-2">
                        Après une première carrière en tant que développeur informatique, je me tourne en 2016 vers le théâtre improvisé. Celui-ci m&apos;amène vers la technique de scène, celle-ci vers les arts numériques et ceux-ci me ramènent au développement informatique. La boucle est bouclée.
                    </div>
                </div>
                <div class="overflow-hidden">
                    <div id="card-2-text-3">
                        Dans ce site, je vous propose de découvrir mes différentes créations, passées, en cours et à venir.
                    </div>
                </div>
                {hasLinkToAbout && (
                    <div class="overflow-hidden">
                    <div id="card-2-text-4">
                        <a href="/a-propos" class="hover:text-accent1 text-white underline transition-colors duration-500">En savoir plus</a>
                    </div>
                </div>)}
            </div>
        </div>
        <WiggleArrow
            id="card-2-scroll-arrow"
            visible={false}
            class="absolute bottom-20 md:bottom-8 lg:bottom-6 z-10"
        />
    </div>
</div>