---
import { cn, getZIndex } from '../../lib/utils';
import WiggleArrow from '../WiggleArrow.astro';

type Props = {
    class?: string;
    cardIndex?: number;
    cardCount?: number;
}

const {
    class: className,
    cardIndex = 0,
    cardCount = 1
} = Astro.props;

const zindex = getZIndex(cardIndex, cardCount);
---

<script>
    import { animate } from 'motion';
    import { parseNumberWithDefault } from '../../lib/utils';

    const cardContainer = document.getElementById('card-3-container')!;
    const scrollArrow = document.getElementById('card-3-scroll-arrow')!;

    const cardIndex = parseNumberWithDefault(cardContainer.dataset.cardIndex, 0);

    const animDuration = 1.7;
    const animDelay = 0.8;
    const titleAnimDuration = 0.6;
    const titleAnimDelay = 0.2;

    function getEnterTransform(index: number, entering: boolean) {
        const isOdd = index % 2 === 0;
        if (window.isSmallScreen()) {
            return entering
                ? (isOdd ? ['translateX(-100%)', 'translateX(0)'] : ['translateX(100%)', 'translateX(0)'])
                : (isOdd ? ['translateX(0)', 'translateX(-100%)'] : ['translateX(0)', 'translateX(100%)']);
        } else {
            return entering
                ? (isOdd ? ['translateY(-100%)', 'translateY(0)'] : ['translateY(100%)', 'translateY(0)'])
                : (isOdd ? ['translateY(0)', 'translateY(-100%)'] : ['translateY(0)', 'translateY(100%)']);
        }
    }

    function getExitTransform(index: number, exiting: boolean) {
        const isOdd = index % 2 === 0;
        if (window.isSmallScreen()) {
            return exiting
                ? (isOdd ? ['translateX(0)', 'translateX(100%)'] : ['translateX(0)', 'translateX(-100%)'])
                : (isOdd ? ['translateX(100%)', 'translateX(0)'] : ['translateX(-100%)', 'translateX(0)']);
        } else {
            return exiting
                ? (isOdd ? ['translateY(0)', 'translateY(100%)'] : ['translateY(0)', 'translateY(-100%)'])
                : (isOdd ? ['translateY(100%)', 'translateY(0)'] : ['translateY(-100%)', 'translateY(0)']);
        }
    }

    function beforeToDuring() {

        show();
        const baseDelay = 2.5;
        const titleStartDelay = baseDelay + animDuration;

        cardContainer.style.setProperty('--card-3-gradient-color-1', 'rgba(0, 0, 0, 1)');
        cardContainer.style.setProperty('--card-3-gradient-color-2', 'rgba(0, 0, 0, 1)');

        for (let i = 0; i < 3; i++) {
            animate(`#card-3-col-${i}`, {
                transform: getEnterTransform(i, true),
                opacity: [0, 1],
            }, {
                duration: animDuration,
                delay: baseDelay,
                ease: 'easeOut'
            });

            animate(`#card-3-col-${i}-title`, {
                transform: ['translateY(-100%)', 'translateY(0)'],
            }, {
                duration: titleAnimDuration,
                delay: titleStartDelay + i * titleAnimDelay,
                ease: 'easeOut'
            });
        }

        animate(".card3-see-more-button", {
            opacity: [0, 1],
        }, {
            duration: titleAnimDuration,
            delay: titleStartDelay + 3 * titleAnimDelay,
            ease: 'easeOut'
        });

        scrollArrow.classList.add('pointer-events-none');
        animate("#card-3-scroll-arrow", {
            opacity: [0, 1],
        }, {
            duration: 0.7 * titleAnimDuration,
            delay: titleStartDelay + 4 * titleAnimDelay,
            ease: 'linear'
        }).then(() => {
            scrollArrow.classList.remove('pointer-events-none');
            window.unlockCardsAnimation();
        });
    }

    function duringToBefore() {
        scrollArrow.classList.add('pointer-events-none');
        animate("#card-3-scroll-arrow", {
            opacity: [1, 0],
        }, {
            duration: 0.5 * titleAnimDuration,
            delay: 0,
            ease: 'linear'
        });

        const titlesOutDuration = (2 * titleAnimDelay) + titleAnimDuration;
        const colStartDelay = titlesOutDuration;

        for (let i = 0; i < 3; i++) {
            animate(`#card-3-col-${i}-title`, {
                transform: ['translateY(0)', 'translateY(-100%)'],
            }, {
                duration: titleAnimDuration,
                delay: (2 - i) * titleAnimDelay,
                ease: 'easeIn'
            });

            const animation = animate(`#card-3-col-${i}`, {
                transform: getEnterTransform(i, false),
                opacity: [1, 0],
            }, {
                duration: animDuration,
                delay: colStartDelay,
                ease: 'easeIn'
            });

            if (i === 2) {
                animation.then(() => {
                    hide();
                });
            }
        }
    }

    function duringToAfter() {
        scrollArrow.classList.add('pointer-events-none');
        animate("#card-3-scroll-arrow", {
            opacity: [1, 0],
        }, {
            duration: 0.5 * titleAnimDuration,
            delay: 0,
            ease: 'linear'
        });

        const titlesOutDuration = (2 * titleAnimDelay) + titleAnimDuration;
        const colStartDelay = titlesOutDuration;

        for (let i = 0; i < 3; i++) {
            animate(`#card-3-col-${i}-title`, {
                transform: ['translateY(0)', 'translateY(-100%)'],
            }, {
                duration: titleAnimDuration,
                delay: (3 - i) * titleAnimDelay,
                ease: 'easeIn'
            });

            animate(`#card-3-col-${i}`, {
                transform: getExitTransform(i, true),
                opacity: [1, 0],
            }, {
                duration: animDuration,
                delay: colStartDelay,
                ease: 'easeIn'
            });
        }

        animate(".card3-see-more-button", {
            opacity: [1, 0],
        }, {
            duration: 1.0,
            delay: 0,
            ease: 'easeOut'
        });

        animate(cardContainer, {
            '--card-3-gradient-color-1': 'rgba(0, 0, 0, 0)',
        }, {
            duration: 0.8,
            delay: 1.5,
            ease: 'easeInOut'
        });

        animate(cardContainer, {
            '--card-3-gradient-color-2': 'rgba(0, 0, 0, 0)',
        }, {
            duration: 0.8,
            delay: 2.15,
            ease: 'easeInOut'
        }).then(() => {
            hide();
        });

        
    }

    function afterToDuring() {
        show();

        const useSimpleAnim = window.isSmallScreen();
        const titleStartDelay = animDuration;

        cardContainer.style.setProperty('--card-3-gradient-color-1', 'rgba(0, 0, 0, 1)');
        cardContainer.style.setProperty('--card-3-gradient-color-2', 'rgba(0, 0, 0, 1)');

        for (let i = 0; i < 3; i++) {
            if (useSimpleAnim) {
                animate(`#card-3-col-${i}`, {
                    opacity: [0, 1],
                }, {
                    duration: animDuration,
                    delay: 0,
                    ease: 'easeOut'
                });
            } else {
                animate(`#card-3-col-${i}`, {
                    transform: getExitTransform(i, false),
                    opacity: [0, 1],
                }, {
                    duration: animDuration,
                    delay: 0,
                    ease: 'easeOut'
                });
            }

            animate(`#card-3-col-${i}-title`, {
                transform: ['translateY(-100%)', 'translateY(0)'],
            }, {
                duration: titleAnimDuration,
                delay: titleStartDelay + i * titleAnimDelay,
                ease: 'easeOut'
            });

        }

        animate(".card3-see-more-button", {
            opacity: [0, 1],
        }, {
            duration: titleAnimDuration,
            delay: titleStartDelay + 3 * titleAnimDelay,
            ease: 'easeOut'
        });


        scrollArrow.classList.add('pointer-events-none');
        animate("#card-3-scroll-arrow", {
            opacity: [0, 1],
        }, {
            duration: 0.7 * titleAnimDuration,
            delay: titleStartDelay + 3 * titleAnimDelay,
            ease: 'linear'
        }).then(() => {
            scrollArrow.classList.remove('pointer-events-none');
            window.unlockCardsAnimation();
        });

        animate(cardContainer, {
            '--card-3-gradient-color-1': 'rgba(0, 0, 0, 1)'
        }, {
            duration: 0.8,
            delay: 0.65,
            ease: 'easeInOut'
        });

        animate(cardContainer, {
            '--card-3-gradient-color-2': 'rgba(0, 0, 0, 1)'
        }, {
            duration: 0.8,
            delay: 0,
            ease: 'easeInOut'
        });
    }

    function hide() {
        cardContainer.classList.add('hidden');
    }

    function show() {
        cardContainer.classList.remove('hidden');
    }

    window.registerCard(cardIndex,
        [
            "portfolio"
        ],
        {
            beforeToDuring,
            duringToBefore,
            duringToAfter,
            afterToDuring,
            hide,
            show
        }
    );
</script>

<div
    class={cn(
        "fixed w-screen h-screen",
        "card-3-gradient",
        className
    )}
    style={`z-index: ${zindex};`}
    id="card-3-container"
    data-card-index={cardIndex}
    data-card-count={cardCount}
>
    <div class={cn(
        "w-full h-full",
        "grid",
        "grid-rows-3 md:grid-rows-1",
        "md:grid-cols-3",
        "gap-1",
    )}>
        <div
            id="card-3-col-0"
            class={cn(
                "relative overflow-hidden",
                "flex flex-col items-center justify-center",
                "opacity-0",
                "group"
            )}
        >
            <div
                class={cn(
                    "absolute inset-0",
                    "bg-cover bg-center bg-no-repeat",
                    "md:grayscale brightness-50",
                    "group-hover:grayscale-0 group-hover:saturate-[1.2] group-hover:brightness-75 group-hover:scale-105",
                    "transition-all duration-500",
                    "bg-[url('/img/bg-arts-numeriques.jpg')]"
                )}
            />
            <div class={cn(
                "relative z-10",
                "flex flex-col items-center justify-center gap-4",
                "text-white"
            )}>
                <h2 class={cn(
                    "text-3xl md:text-4xl",
                    "text-center",
                    "uppercase italic font-semibold"
                )}>
                    <div class="overflow-hidden">
                        <div id="card-3-col-0-title">Arts numériques</div>
                    </div>
                </h2>
                <a
                    href="/arts-numeriques"
                    class={cn(
                        "px-6",
                        "text-md font-medium uppercase tracking-wider",
                        "transition-all duration-300",
                        "card3-see-more-button",
                        "underline underline-offset-1 italic",
                        "hover:no-underline hover:cursor-pointer",
                        "transition-all duration-300"
                    )}
                >
                    Voir plus
                </a>
            </div>
        </div>

        <div
            id="card-3-col-1"
            class={cn(
                "relative overflow-hidden",
                "flex flex-col items-center justify-center",
                "opacity-0",
                "group"
            )}
        >
            <div
                class={cn(
                    "absolute inset-0",
                    "bg-cover bg-center bg-no-repeat",
                    "md:grayscale brightness-50",
                    "group-hover:grayscale-0 group-hover:saturate-[1.2] group-hover:brightness-75 group-hover:scale-105",
                    "transition-all duration-500",
                    "bg-[url('/img/bg-theatre.jpg')]"
                )}
            />
            <div class={cn(
                "relative z-10",
                "flex flex-col items-center justify-center gap-4",
                "text-white"
            )}>
                <h2 class={cn(
                    "text-3xl md:text-4xl",
                    "text-center",
                    "uppercase italic font-semibold"
                )}>
                    <div class="overflow-hidden">
                        <div id="card-3-col-1-title">Théâtre</div>
                    </div>
                </h2>
                <a
                    href="/theatre"
                    class={cn(
                        "px-6",
                        "text-md font-medium uppercase tracking-wider",
                        "transition-all duration-300",
                        "card3-see-more-button",
                        "underline underline-offset-1 italic",
                        "hover:no-underline hover:cursor-pointer"
                    )}
                >
                    Voir plus
                </a>
            </div>
        </div>

        <div
            id="card-3-col-2"
            class={cn(
                "relative overflow-hidden",
                "flex flex-col items-center justify-center",
                "opacity-0",
                "group"
            )}
        >
            <div
                class={cn(
                    "absolute inset-0",
                    "bg-cover bg-position-[25%_50%] bg-no-repeat",
                    "md:grayscale brightness-50",
                    "group-hover:grayscale-0 group-hover:saturate-[1.2] group-hover:brightness-75 group-hover:scale-105",
                    "transition-all duration-500",
                    "bg-[url('/img/bg-other.jpg')]"
                )}
            />
            <div class={cn(
                "relative z-10",
                "flex flex-col items-center justify-center gap-4",
                "text-white"
            )}>
                <h2 class={cn(
                    "text-3xl md:text-4xl",
                    "text-center",
                    "uppercase italic font-semibold"
                )}>
                    <div class="overflow-hidden">
                        <div id="card-3-col-2-title">Technique</div>
                    </div>
                </h2>
                <a
                    href="/technique"
                    class={cn(
                        "px-6",
                        "text-md font-medium uppercase tracking-wider",
                        "transition-all duration-300",
                        "card3-see-more-button",
                        "underline underline-offset-1 italic",
                        "hover:no-underline hover:cursor-pointer"
                    )}
                >
                    Voir plus
                </a>
            </div>
        </div>
    </div>
    <div class={cn(
        "absolute bottom-20 md:bottom-8 lg:bottom-6 z-10",
        "w-full flex justify-center items-center"
    )}>
        <WiggleArrow
            id="card-3-scroll-arrow"
            visible={false}
        />
    </div>  
</div>

<style>
    .card-3-gradient {
        --card-3-gradient-color-1: rgba(0, 0, 0, 1);
        --card-3-gradient-color-2: rgba(0, 0, 0, 1);
        background: linear-gradient(to top left, var(--card-3-gradient-color-1), var(--card-3-gradient-color-2));
    }
</style>