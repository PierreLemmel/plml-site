---
import { cn, dateText } from '../../lib/utils';

export type PortfolioItemData = {
    id: string;
    title: string;
    disabled?: boolean;
    description: string;
    coverImage: string;
    additionalImages?: string[];
    fullDescription?: string;
    tags?: string[];
    fromDate?: string;
    toDate?: string;
    link?: string;
};

type Props = {
    item: PortfolioItemData;
    class?: string;
}

const { item: {
    id,
    title,
    description,
    fullDescription,
    coverImage,
    tags,
    fromDate,
    toDate,
    link,
    additionalImages,
}, class: className } = Astro.props;
---

<div
    class={cn(
        "portfolio-item group cursor-pointer",
        "relative overflow-hidden",
        "bg-neutral-900 rounded-sm",
        "aspect-4/3",
        className
    )}
    data-item-id={id}
    data-item-title={title}
    data-item-description={description}
    data-item-full-description={fullDescription || description}
    data-item-cover={coverImage}
    data-item-tags={tags?.join(',') || ''}
    data-item-from-date={fromDate}
    data-item-to-date={toDate}
    data-item-link={link || ''}
    data-item-images={JSON.stringify(additionalImages || [])}
>
    <div
        class={cn(
            "absolute inset-0",
            "bg-cover bg-center bg-no-repeat",
            "transition-all duration-500 ease-out",
            "group-hover:scale-110"
        )}
        style={`background-image: url('${coverImage}');`}
    />

    <div class={cn(
        "absolute inset-0",
        "bg-linear-to-t from-black/90 via-black/30 to-transparent",
        "opacity-80 group-hover:opacity-100",
        "transition-opacity duration-300"
    )} />

    <div class={cn(
        "absolute inset-0",
        "flex flex-col justify-end",
        "p-4 md:p-5"
    )}>
        <div class={cn(
            
        )}>
            {fromDate && (
                <span class={cn(
                    "text-xs font-medium tracking-wider uppercase",
                    "text-white/80 mb-1 block"
                )}>
                    {dateText(fromDate, toDate)}
                </span>
            )}
            <h3 class={cn(
                "text-lg md:text-xl font-semibold uppercase",
                "text-white mb-1",
                "line-clamp-2",
            )}>
                {title}
            </h3>       
            <p class={cn(
                "text-sm text-neutral-300",
                "line-clamp2 md:line-clamp-3",
                "opacity-0 group-hover:opacity-100",
                "transition-all duration-300 delay-75",
                "max-h-0 group-hover:max-h-32",
            )}>
                {description}
            </p>
        </div>
    </div>

    <div class={cn(
        "absolute top-3 right-3",
        "w-8 h-8",
        "flex items-center justify-center",
        "bg-white/10 backdrop-blur-sm rounded-full",
        "opacity-0 group-hover:opacity-100",
        "transform scale-50 group-hover:scale-100",
        "transition-all duration-300"
    )}>
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
        </svg>
    </div>
</div>

<script>
    import { dateText } from "../../lib/utils";

    const items = document.querySelectorAll('.portfolio-item');
    const overlay = document.getElementById('portfolio-overlay');

    items.forEach(item => {
        item.addEventListener('click', () => {
            const title = item.getAttribute('data-item-title') || '';
            const description = item.getAttribute('data-item-full-description') || '';
            const cover = item.getAttribute('data-item-cover') || '';
            const tags = item.getAttribute('data-item-tags')?.split(',') || [];
            const fromDate = item.getAttribute('data-item-from-date');
            const toDate = item.getAttribute('data-item-to-date');
            const link = item.getAttribute('data-item-link');
            const images = JSON.parse(item.getAttribute('data-item-images') || '[]');

            window.setupOverlay({
                title,
                description,
                cover,
                images,
                fromDate,
                toDate,
                link,
                tags
            });
            
        });
    });
</script>