---
import { cn, dateText } from '../../lib/utils';
import type { PortfolioItemData } from '../../contents/content-types';
import ExternalLinkSvg from '../icons/external-link-svg.astro';

type Props = {
    item: PortfolioItemData;
    class?: string;
}

const { item: {
    id,
    title,
    description,
    fullDescription,
    coverImage,
    tags,
    roles,
    fromDate,
    toDate,
    link,
    additionalImages,
    additionalInfo,
}, class: className } = Astro.props;
---

<div
    class={cn(
        "portfolio-item group cursor-pointer",
        "relative overflow-hidden",
        "bg-neutral-900 rounded-sm",
        "aspect-4/3",
        className
    )}
    data-item-id={id}
    data-item-title={title}
    data-item-description={description}
    data-item-full-description={fullDescription || description}
    data-item-cover={coverImage}
    data-item-tags={tags?.join(',') || ''}
    data-item-roles={roles?.join(',') || ''}
    data-item-from-date={fromDate}
    data-item-to-date={toDate}
    data-item-link={link || ''}
    data-item-images={JSON.stringify(additionalImages || [])}
    data-item-additional-info={JSON.stringify(additionalInfo || [])}
>
    <div
        class={cn(
            "absolute inset-0",
            "bg-cover bg-center bg-no-repeat",
            "transition-all duration-500 ease-out",
            "group-hover:scale-110"
        )}
        style={`background-image: url('${coverImage}');`}
    />

    <div class={cn(
        "absolute inset-0",
        "bg-linear-to-t from-black/90 via-black/30 to-transparent",
        "opacity-80 group-hover:opacity-100",
        "transition-opacity duration-300"
    )} />

    <div class={cn(
        "absolute inset-0",
        "flex flex-col justify-end",
        "p-4 md:p-5"
    )}>
        <div class={cn(
            
        )}>
            {fromDate && (
                <span class={cn(
                    "text-xs font-medium tracking-wider uppercase",
                    "text-white/80 mb-1 block"
                )}>
                    {dateText(fromDate, toDate)}
                </span>
            )}
            <h3 class={cn(
                "text-lg md:text-xl font-semibold uppercase",
                "text-white mb-1",
                "line-clamp-2",
            )}>
                {title}
            </h3>       
            <p class={cn(
                "text-sm text-neutral-300",
                "line-clamp2 md:line-clamp-3",
                "opacity-0 group-hover:opacity-100",
                "transition-all duration-300 delay-75",
                "max-h-0 group-hover:max-h-32",
            )}>
                {description}
            </p>
        </div>
    </div>

    <div class={cn(
        "absolute top-3 right-3",
        "w-8 h-8",
        "flex items-center justify-center",
        "bg-white/10 backdrop-blur-sm rounded-full",
        "opacity-0 group-hover:opacity-100",
        "transform scale-50 group-hover:scale-100",
        "transition-all duration-300"
    )}>
        <ExternalLinkSvg class="w-4 h-4 text-white" />
    </div>
</div>

<script>
    const items = document.querySelectorAll('.portfolio-item');

    items.forEach(item => {
        const itemId = item.getAttribute('data-item-id');
        if (itemId) {
            item.addEventListener('click', () => {
                window.openOverlay(itemId);
            });
        }
        else {
            console.error('Portfolio item with no item id found');
        }
    });
</script>