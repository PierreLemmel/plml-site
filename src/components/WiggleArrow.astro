---
import { cn } from '../lib/utils';

type Props = {
    id?: string;
    visible?: boolean;
    class?: string;
}

const {
    id,
    visible = true,
    class: className,
} = Astro.props;

---

<div
    id={id}
    class={cn(
        "flex items-center justify-center",
        "pointer-events-none",
        className
    )}
    style={{
        opacity: visible ? 1 : 0,
    }}
>
    <svg
        onclick="window.scrollToNextCard()"
        class={cn(
            "size-12",
            "text-white/50",
            "animate-bounce-down",
            "transition-all duration-300 ease-in-out",
            "hover:cursor-pointer hover:text-white hover:scale-110",
        )}
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M6 9 L12 15 L18 9"/>
    </svg>
</div>

<style>
    @keyframes bounce-down {
        0%, 100% {
            transform: translateY(0);
            opacity: 0.5;
        }
        50% {
            transform: translateY(6px);
            opacity: 1;
        }
    }

    .animate-bounce-down {
        animation: bounce-down 1.5s ease-in-out infinite;
    }
</style>

