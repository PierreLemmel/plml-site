---
import PortfolioPage from '../components/portfolio/PortfolioPage.astro';
import PortfolioItem from '../components/portfolio/PortfolioItem.astro';
import type { PortfolioItemData } from '../components/portfolio/PortfolioItem.astro';
import { contentItems } from '../contents/content-items';

const items: PortfolioItemData[] = [
    contentItems.QuelqueChoseAChangeDansLAir,
    contentItems.Aleas,
];
---

<PortfolioPage
    title="Plml - Théâtre"
    description="Improvisation, créations et mises en scène"
    pageTitle="Théâtre"
    subtitle="Improvisation, créations et mises en scène"
    backgroundImage="/img/bg-theatre.jpg"
    backgroundClass="brightness-[0.4]"
>
    {items.filter(item => !item.disabled).map(item => (
        <PortfolioItem item={item} />
    ))}
</PortfolioPage>
