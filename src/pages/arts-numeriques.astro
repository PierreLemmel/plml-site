---
import PortfolioPage from '../components/portfolio/PortfolioPage.astro';
import PortfolioItem from '../components/portfolio/PortfolioItem.astro';
import type { PortfolioItemData } from '../components/portfolio/PortfolioItem.astro';
import { contentItems } from '../contents/content-items';

const items: PortfolioItemData[] = [
    contentItems.Aleas,
];
---

<PortfolioPage
    title="Plml - Arts Numériques"
    description="Explorations à l'intersection de l'art et de la technologie - Installations interactives, art génératif et créations numériques par Pierre Lemmel."
    pageTitle="Arts Numériques"
    subtitle="Explorations à l'intersection de l'art et de la technologie"
    backgroundImage="/img/bg-arts-numeriques.jpg"
>
    {items.map(item => (
        <PortfolioItem item={item} />
    ))}
</PortfolioPage>
