---
import PortfolioPage from '../components/portfolio/PortfolioPage.astro';
import PortfolioItem from '../components/portfolio/PortfolioItem.astro';
import type { PortfolioItemData } from '../contents/content-types';
import { techniqueItems } from '../contents/content-technique-items';

const items: PortfolioItemData[] = [
    techniqueItems.BibiFish,
    techniqueItems.SauteMoutons,
    techniqueItems.Frichti,
    techniqueItems.Reed,
];

const description = "Réalisations techniques diverses, prestations pour différents clients ou développements personnels d'outils pour le spectacle vivant, des installations immersives ou encore de la muséographie."
---

<PortfolioPage
    title="Plml - Technique"
    description={description}
    headerDescription={description}
    pageTitle="Technique"
    subtitle="Ateliers, collaborations et projets transversaux"
    backgroundImage="/img/bg-other.jpg"
    backgroundPosition="25% 50%"
    backgroundClass="brightness-[0.7]"
>
    {items.map(item => (
        <PortfolioItem item={item} />
    ))}
</PortfolioPage>


