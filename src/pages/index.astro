---
import Layout from '../layouts/Layout.astro';
import { cn } from '../lib/utils';

import Card1 from '../components/cards/Card1.astro';
import Card2 from '../components/cards/Card2.astro';
import Card3 from '../components/cards/Card3.astro';
import Card4 from '../components/cards/Card4.astro';
import Stepper from '../components/Stepper.astro';

const cardCount = 4;
let cardIndex = 0;
---

<script>
	import { parseNumberWithDefault } from "../lib/utils";

	type CardState = 'before' | 'during' | 'after';

	type CardTransitions = {
		beforeToDuring: () => void;
		duringToBefore: () => void;
		duringToAfter: () => void;
		afterToDuring: () => void;
		hide: () => void;
		show: () => void;
	};

	declare global {
		interface Window {
			registerCard: (index: number, ids: string[], transitions: CardTransitions) => void;

			goToNextCard: () => void;
			goToPrevCard: () => void;
			goToCard: (targetIndex: number) => void;
			unlockCardsAnimation: () => void;

			isSmallScreen: () => boolean;
		}
	}

	const cardCount = parseNumberWithDefault(document.getElementById('main-container')?.dataset.cardCount, 2);
	
	const cardIds: Map<number, string[]> = new Map();
	const slugToIndex: Map<string, number> = new Map();

	let currentCardIndex = -1;
	let isAnimating = false;
	const cardStates: Map<number, CardState> = new Map();
	const cardTransitions: Map<number, CardTransitions> = new Map();

	for (let i = 0; i < cardCount; i++) {
		cardStates.set(i, 'before');
	}

	function getCardIndexFromUrl(): number | null {
		const params = new URLSearchParams(window.location.search);
		const cardParam = params.get('card');
		if (cardParam && slugToIndex.has(cardParam)) {
			return slugToIndex.get(cardParam)!;
		}
		return null;
	}

	function dispatchCardChanged(index: number) {
		currentCardIndex = index;
		window.dispatchEvent(new CustomEvent('cardchanged', { detail: { index } }));
	}

	function lockAnimation() {
		isAnimating = true;
	}

	window.unlockCardsAnimation = () => {
		isAnimating = false;
	};

	window.registerCard = (index: number, ids: string[], transitions: CardTransitions) => {
		cardTransitions.set(index, transitions);
		cardIds.set(index, ids);
		ids.forEach(id => slugToIndex.set(id, index));
	};

	function canTransitionTo(targetIndex: number): boolean {
		return !isAnimating && 
			targetIndex !== currentCardIndex &&
			targetIndex >= 0 && 
			targetIndex < cardCount;
	}

	function transitionToCard(targetIndex: number) {
		if (!canTransitionTo(targetIndex)) return;
		
		lockAnimation();

		const goingForward = targetIndex > currentCardIndex;
		const previousIndex = currentCardIndex;
		const currentTransitions = cardTransitions.get(currentCardIndex);
		const targetTransitions = cardTransitions.get(targetIndex);

		cardTransitions.forEach((transition, index) => {
			if (index === currentCardIndex || index === targetIndex) {
				transition.show();
			} else {
				transition.hide();
			}
		});

		if (goingForward) {
			const currentState = cardStates.get(currentCardIndex);
			if (currentState === 'during' && currentTransitions?.duringToAfter) {
				cardStates.set(currentCardIndex, 'after');
				currentTransitions.duringToAfter();
			} else if (currentState === 'during') {
				cardStates.set(currentCardIndex, 'before');
				currentTransitions?.duringToBefore();
			}

			for (let i = previousIndex + 1; i < targetIndex; i++) {
				cardStates.set(i, 'after');
			}

			if (targetTransitions) {
				const targetState = cardStates.get(targetIndex);
				if (targetState === 'before') {
					cardStates.set(targetIndex, 'during');
					targetTransitions.beforeToDuring();
				} else if (targetState === 'after' && targetTransitions.afterToDuring) {
					cardStates.set(targetIndex, 'during');
					targetTransitions.afterToDuring();
				}
			}
		} else {
			const currentState = cardStates.get(currentCardIndex);
			if (currentState === 'during') {
				cardStates.set(currentCardIndex, 'before');
				currentTransitions?.duringToBefore();
			}

			for (let i = previousIndex - 1; i > targetIndex; i--) {
				cardStates.set(i, 'before');
			}

			if (targetTransitions) {
				const targetState = cardStates.get(targetIndex);
				if (targetState === 'after' && targetTransitions.afterToDuring) {
					cardStates.set(targetIndex, 'during');
					targetTransitions.afterToDuring();
				} else if (targetState === 'before') {
					cardStates.set(targetIndex, 'during');
					targetTransitions.beforeToDuring();
				}
			}
		}

		dispatchCardChanged(targetIndex);
	}

	window.goToNextCard = () => {
		transitionToCard(currentCardIndex + 1);
	};

	window.goToPrevCard = () => {
		transitionToCard(currentCardIndex - 1);
	};

	window.goToCard = (targetIndex: number) => {
		transitionToCard(targetIndex);
	};

	window.addEventListener('wheel', (event) => {
		if (isAnimating) return;

		if (event.deltaY > 0) {
			window.goToNextCard();
		} else if (event.deltaY < 0) {
			window.goToPrevCard();
		}
	}, { passive: true });

	let touchStartY = 0;
	let touchEndY = 0;
	const minSwipeDistance = 50;

	window.addEventListener('touchstart', (event) => {
		touchStartY = event.touches[0].clientY;
	}, { passive: true });

	window.addEventListener('touchend', (event) => {
		touchEndY = event.changedTouches[0].clientY;
		const swipeDistance = touchStartY - touchEndY;
		
		if (Math.abs(swipeDistance) < minSwipeDistance) return;
		if (isAnimating) return;

		if (swipeDistance > 0) {
			window.goToNextCard();
		} else {
			window.goToPrevCard();
		}
	}, { passive: true });

	window.isSmallScreen = () => {
		return window.innerWidth < 768;
	};

	document.body.style.overflow = 'hidden';

	const startInterval = setInterval(() => {
		if (cardTransitions.size < cardCount) return;

		const card0 = cardTransitions.get(0);
		if (card0) {
			const initialCardIndex = getCardIndexFromUrl() ?? 0;

			for (let i = 0; i < initialCardIndex; i++) {
				cardStates.set(i, 'after');
			}
			
			transitionToCard(initialCardIndex);

			clearInterval(startInterval);
		}
	}, 10);
</script>

<Layout
	title="Plml - Pierre Lemmel"
	description="Pierre Lemmel - Comédien, metteur en scène et artiste numérique. Découvrez mes créations."
	hideFooter={true}
>
	<main
		id="main-container"
		class={cn(
			"text-white font-barlow",
			"h-screen w-screen overflow-hidden",
			"bg-black"
		)}
		data-card-count={cardCount}
	>
		<Card1 cardIndex={cardIndex++} cardCount={cardCount} />
		<Card2 cardIndex={cardIndex++} cardCount={cardCount} />
		<Card3 cardIndex={cardIndex++} cardCount={cardCount} />
		<Card4 cardIndex={cardIndex++} cardCount={cardCount} />
		<Stepper labels={['Accueil', 'À\u00A0propos', 'Portfolio', 'Contact']} />
    </main>
</Layout>
