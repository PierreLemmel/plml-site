---
import Layout from '../layouts/Layout.astro';
import { cn } from '../lib/utils';

import Card1 from '../components/cards/Card1.astro';
import Card2 from '../components/cards/Card2.astro';
import Card3 from '../components/cards/Card3.astro';
import Card4 from '../components/cards/Card4.astro';

const cardCount = 4;
let cardIndex = 0;
---

<script>
	import { parseNumberWithDefault } from "../lib/utils";


	declare global {
		interface Window {
			setCardIndex: (index: number) => void;
			getCardIndex: () => number;

			canGoToCard: (index: number,) => boolean;
			scrollToNextCard: () => void;

			lockScroll: () => void;
			unlockScroll: () => void;
		}
	}

	let globalCardIndex = 0;
	window.setCardIndex = (index: number) => {
		globalCardIndex = index;
	};
	window.getCardIndex = () => {
		return globalCardIndex;
	};

	const cardCount = parseNumberWithDefault(document.getElementById('main-container')?.dataset.cardCount, 2);

	window.canGoToCard = (index: number) => {
		return Math.abs(index - globalCardIndex) === 1 && index >= 0 && index < cardCount;
	};

	history.scrollRestoration = 'manual';
	window.scrollToNextCard = () => {
		window.scrollTo({
			top: (globalCardIndex + 1) * window.innerHeight,
			behavior: 'smooth'
		});
	};

	window.lockScroll = () => {
		document.body.style.overflowY = 'hidden';
	};
	window.unlockScroll = () => {
		document.body.style.overflowY = 'auto';
	};
</script>

<Layout
	title="Plml - Pierre Lemmel"
	description="Pierre Lemmel - Comédien, metteur en scène et artiste numérique. Découvrez mes créations."
>
    <main
		id="main-container"
		class={cn(
			"text-white font-barlow"
		)}
		style={`min-height: ${100 * (cardCount)}vh;`}
		data-card-count={cardCount}
	>
		<Card1 cardIndex={cardIndex++} cardCount={cardCount} />
		<Card2 cardIndex={cardIndex++} cardCount={cardCount} />
		<Card3 cardIndex={cardIndex++} cardCount={cardCount} />
		<Card4 cardIndex={cardIndex++} cardCount={cardCount} />
    </main>
</Layout>
