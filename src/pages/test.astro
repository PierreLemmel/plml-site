---
import Layout from '../layouts/Layout.astro';
import { cn } from '../lib/utils';

import Card1 from '../components/cards/Card1.astro';
import Card2 from '../components/cards/Card2.astro';
import Card3 from '../components/cards/Card3.astro';
import Card4 from '../components/cards/Card4.astro';

const cardCount = 1;
---

<script>
	import { parseNumberWithDefault } from "../lib/utils";

	type CardState = 'before' | 'during' | 'after';

	type CardTransitions = {
		beforeToDuring: () => void;
		duringToBefore: () => void;
		duringToAfter?: () => void;
		afterToDuring?: () => void;
	};

	declare global {
		interface Window {
			registerCard: (index: number, transitions: CardTransitions) => void;

			goToNextCard: () => void;
			goToPrevCard: () => void;
			unlockCardsAnimation: () => void;

			isSmallScreen: () => boolean;
		}
	}

	window.registerCard = (index: number, transitions: CardTransitions) => {};
	window.goToNextCard = () => {};
	window.goToPrevCard = () => {};
	window.unlockCardsAnimation = () => {};
	window.isSmallScreen = () => {
		return window.innerWidth < 768;
	};
</script>


<Layout>
    <main
		id="main-container"
		class={cn(
			"text-white font-barlow"
		)}
		style={`min-height: ${100 * (cardCount)}vh;`}
		data-card-count={cardCount}
	>
		<Card4 class="z-100" cardIndex={0} cardCount={cardCount} />
    </main>
</Layout>
