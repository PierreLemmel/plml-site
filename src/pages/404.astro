---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page non trouvée" noindex={true}>
    <main class="min-h-screen w-full flex flex-col items-center justify-center bg-zinc-950 text-white font-barlow">
        <h1 class="text-[12rem] md:text-[16rem] font-black leading-none text-accent1 opacity-20 select-none">
            404
        </h1>
        <div class="flex flex-col items-center gap-4 -mt-16 md:-mt-20">
            <h2 class="text-2xl md:text-4xl font-light tracking-wide">
                Page non trouvée
            </h2>
            <p class="text-zinc-400 text-center max-w-md px-4">
                La page que vous recherchez n'existe pas ou a été déplacée.
            </p>
            <a
                href="/"
                class="mt-6 px-6 py-3 border border-accent1 text-accent1 hover:bg-accent1 hover:text-white transition-colors duration-300 tracking-wider uppercase text-sm"
            >
                Retour à l'accueil
            </a>
        </div>
    </main>
</Layout>

